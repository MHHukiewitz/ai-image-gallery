# Template for /opt/ai-gallery/.env on ops-server. docs/deploy.md step 1 copies it there.
# Fill in every CHANGE_ME. scripts/deploy.sh refuses to deploy while one is left.
# This file lives only on the server: never commit the filled-in copy.
#
# deploy/compose.prod.yml reads these names. .env.example at the repo root lists every setting
# the app understands, with local-development defaults. Use this file for production instead,
# so a local value (127.0.0.1, ANALYZER=fake) can't leak into the deployed stack.

# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API Keys in the Supabase dashboard)
# ---------------------------------------------------------------------------
# Project URL, for example https://abcdefghijklmnop.supabase.co
SUPABASE_URL=CHANGE_ME
# Public by design.
SUPABASE_PUBLISHABLE_KEY=CHANGE_ME
# Worker only. Bypasses RLS: never share it, never paste it into a ticket or chat.
SUPABASE_SECRET_KEY=CHANGE_ME
# No SUPABASE_JWT_SECRET here on purpose. Production signs tokens with ES256 and the API
# verifies them against the project's JWKS.

# The browser bundle gets these two at build time. They must equal the two values above.
VITE_SUPABASE_URL=CHANGE_ME
VITE_SUPABASE_PUBLISHABLE_KEY=CHANGE_ME

# ---------------------------------------------------------------------------
# AI analysis (worker)
# ---------------------------------------------------------------------------
# openai_compat = production: Claude through OpenRouter (AI_API_KEY, AI_MODEL, AI_BASE_URL).
# Other providers need no code change:
#   ANALYZER=anthropic      the native adapter, plus ANTHROPIC_API_KEY
#   ANALYZER=fake           deterministic placeholder tags, for a smoke test only
# Empty the CHANGE_ME values you don't use (for example ANTHROPIC_API_KEY=) before deploying.
ANALYZER=openai_compat
AI_API_KEY=CHANGE_ME
AI_BASE_URL=https://openrouter.ai/api/v1
# Model id from the benchmark in #6. With ANALYZER=anthropic, use claude-haiku-5-5.
AI_MODEL=anthropic/claude-haiku-5.5
# Only for ANALYZER=anthropic.
ANTHROPIC_API_KEY=
# low, medium or high. Only the anthropic adapter sends it.
AI_EFFORT=low

# ---------------------------------------------------------------------------
# Embeddings for "find similar" (worker)
# ---------------------------------------------------------------------------
# fastembed = the worker embeds each analyzed image with a small local model (no API, no key) and
# stores the vector in Postgres, so "find similar" matches on meaning ("dog" with "puppy").
# none = tag words only. After switching it on for the first time, embed the images analyzed
# before with: docker compose -f deploy/compose.prod.yml run --rm worker python -m gallery.backfill_embeddings
EMBEDDER=fastembed
# The model is baked into the image. Change these only together with a rebuild, and recalibrate
# search_embedding_floor() first (docs/architecture.md section 8).
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------------------
# Uploads (api)
# ---------------------------------------------------------------------------
# Uploads decoded at once. Each phone photo holds tens of megabytes while it decodes, so raise it
# only together with the api's mem_limit in compose.prod.yml. Unset means 2.
# UPLOAD_PROCESSING_CONCURRENCY=2
# Uploads one user may make in a rolling 24 h window. 0 = no limit. Re-uploading an image the
# user already has doesn't count, and deleting an image doesn't give its slot back.
UPLOAD_DAILY_QUOTA=300
# User ids (UUIDs) that skip the quota, comma-separated. Set the owner's real id (auth.users.id)
# here, on the server only. The example id is a placeholder. A malformed id stops the API at
# startup.
UPLOAD_QUOTA_EXEMPT_USER_IDS=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------------
# Error reporting (optional, #30). Empty DSNs keep Sentry off.
# ---------------------------------------------------------------------------
SENTRY_DSN=
VITE_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Optional tuning. The defaults in api/src/gallery/config.py apply when a line is absent.
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO
# WORKER_CONCURRENCY=4
