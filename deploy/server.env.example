# Template for /opt/ai-gallery/.env on ops-server. docs/deploy.md step 1 copies it there.
# Fill in every CHANGE_ME. scripts/deploy.sh refuses to deploy while one is left.
# This file lives only on the server: never commit the filled-in copy.
#
# deploy/compose.prod.yml reads these names. .env.example at the repo root lists every setting
# the app understands, with local-development defaults. Use this file for production instead,
# so a local value (127.0.0.1, ANALYZER=fake) can't leak into the deployed stack.

# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API Keys in the Supabase dashboard)
# ---------------------------------------------------------------------------
# Project URL, for example https://abcdefghijklmnop.supabase.co
SUPABASE_URL=CHANGE_ME
# Public by design.
SUPABASE_PUBLISHABLE_KEY=CHANGE_ME
# Worker only. Bypasses RLS: never share it, never paste it into a ticket or chat.
SUPABASE_SECRET_KEY=CHANGE_ME
# No SUPABASE_JWT_SECRET here on purpose. Production signs tokens with ES256 and the API
# verifies them against the project's JWKS.

# The browser bundle gets these two at build time. They must equal the two values above.
VITE_SUPABASE_URL=CHANGE_ME
VITE_SUPABASE_PUBLISHABLE_KEY=CHANGE_ME

# ---------------------------------------------------------------------------
# AI analysis (worker)
# ---------------------------------------------------------------------------
# anthropic = production (needs ANTHROPIC_API_KEY and AI_MODEL).
# Until the Anthropic key exists, an interim provider works without a code change:
#   ANALYZER=openai_compat  plus AI_API_KEY, AI_MODEL and AI_BASE_URL (below)
#   ANALYZER=fake           deterministic placeholder tags, for a smoke test only
# Empty the CHANGE_ME values you don't use (for example ANTHROPIC_API_KEY=) before deploying.
ANALYZER=anthropic
ANTHROPIC_API_KEY=CHANGE_ME
# Model id from the benchmark in #6, for example claude-haiku-5-5.
AI_MODEL=CHANGE_ME
# low, medium or high.
AI_EFFORT=low
# Only for ANALYZER=openai_compat. Leave commented out otherwise.
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=

# ---------------------------------------------------------------------------
# Error reporting (optional, #30). Empty DSNs keep Sentry off.
# ---------------------------------------------------------------------------
SENTRY_DSN=
VITE_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Optional tuning. The defaults in api/src/gallery/config.py apply when a line is absent.
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO
# WORKER_CONCURRENCY=4
