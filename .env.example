# Copy to .env and fill in. .env is gitignored: never commit real keys.
# The API and worker read this file (api/.env overrides it); empty values count as unset.
# Docker compose and the production deploy use the same variable names.

# ---------------------------------------------------------------------------
# Supabase (api, worker)
# ---------------------------------------------------------------------------
# Local `supabase start` prints these. In production use the Supabase Cloud project's values.
SUPABASE_URL=http://127.0.0.1:54321
# Public by design. The browser gets the same value as VITE_SUPABASE_PUBLISHABLE_KEY.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Worker only. Bypasses RLS, so it never goes to the API or the browser.
SUPABASE_SECRET_KEY=
# Where the API fetches signing keys. Empty derives {SUPABASE_URL}/auth/v1/.well-known/jwks.json.
SUPABASE_JWKS_URL=
# HS256 fallback for local `supabase start`. Leave empty in production (JWKS is used).
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Storage and upload limits (api, worker)
# ---------------------------------------------------------------------------
STORAGE_BUCKET=images
SIGNED_URL_TTL_SECONDS=3600
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=40000000
# Uploads decoded at the same time. The rest wait, so a burst can't exhaust the API's memory.
UPLOAD_PROCESSING_CONCURRENCY=2

# ---------------------------------------------------------------------------
# AI analysis (worker)
# ---------------------------------------------------------------------------
# fake = deterministic, no key needed. anthropic = production (Claude). openai_compat = benchmark/fallback.
ANALYZER=fake
# Claude API key from a spend-limited workspace (#28). Used when ANALYZER=anthropic.
ANTHROPIC_API_KEY=
# Claude effort level: low, medium or high.
AI_EFFORT=low
# Model id, for example claude-haiku-5-5. Set from the benchmark in #6.
AI_MODEL=claude-haiku-5-5
AI_TIMEOUT_SECONDS=30.0
# OpenAI-compatible endpoint, used only when ANALYZER=openai_compat.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=

# ---------------------------------------------------------------------------
# Tag verification (worker, optional)
# ---------------------------------------------------------------------------
# none = keep the analyzer's tags. jev = check them against the image with TypeSafe Jev and merge
# near-duplicates. Jev's image input is experimental, so this is off by default. A failure or
# timeout keeps the original tags and never fails a job.
TAG_VERIFIER=none
# TypeSafe API key. Needed only when TAG_VERIFIER=jev.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0
# Tags scored below this (0 to 1) are dropped, but the result always keeps at least five.
TAG_MIN_PROBABILITY=0.5
# Time budget for the whole verification call, in seconds.
TAG_VERIFIER_TIMEOUT_SECONDS=5.0

# ---------------------------------------------------------------------------
# Embeddings for "find similar" (worker, optional)
# ---------------------------------------------------------------------------
# none = "find similar" scores on tag words alone. fastembed = the worker also embeds each analyzed
# image's description and tags with a small local model (no API, no key) and stores the vector in
# Postgres through pgvector. A failure never fails a job. After switching it on, run
# `python -m gallery.backfill_embeddings` once to embed the images analyzed before.
EMBEDDER=none
# The model behind the vectors. Another model means a new calibration of search_embedding_floor()
# (docs/architecture.md section 8) and a new backfill. It must make 384-dimensional vectors.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where fastembed finds the model. The Docker image downloads it into /opt/models at build time.
# Locally, point it at any writable folder: the first run downloads about 65 MB into it.
EMBEDDING_CACHE_DIR=/opt/models

# ---------------------------------------------------------------------------
# Worker loop
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_POLL_MIN_SECONDS=1.0
WORKER_POLL_MAX_SECONDS=10.0
JOB_MAX_ATTEMPTS=3
JOB_STALE_AFTER_SECONDS=300

# ---------------------------------------------------------------------------
# Logging and error reporting (api, worker)
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Empty disables Sentry: nothing is sent anywhere.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# 0.0 = errors only, no performance tracing.
SENTRY_TRACES_SAMPLE_RATE=0.0
# Git SHA, set by the deploy script.
RELEASE=

# ---------------------------------------------------------------------------
# web (build-time, public)
# Everything below ends up in the browser bundle. Never put a secret here.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_API_BASE=/api
# true = serve the API from MSW mocks, so the web app runs without a backend.
VITE_USE_MOCKS=false
VITE_MAX_UPLOAD_MB=10
# Empty disables Sentry in the browser.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_RELEASE=
